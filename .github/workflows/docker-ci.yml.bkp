name: Demo Flask app CI

on:
  push:
    branches:
      - main

jobs:
  docker-build:
    runs-on: ubuntu-latest

    steps:
      

      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Build Docker Image
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/flask-demo-app:latest .
          docker build -t ${{ secrets.DOCKER_USERNAME }}/flask-demo-app:${{ github.sha }} .

      - name: Login in Docker Hub
        uses: docker/login-action@v3
        with: 
          username: ${{ secrets.DOCKER_USERNAME }} 
          password: ${{ secrets.DOCKER_PASSWORD }}      

      - name: Run Docker container
        run: |
          docker run -d -p 5000:5000 --name flask-demo-app ${{ secrets.DOCKER_USERNAME }}/flask-demo-app:${{ github.sha }}

      - name: Waiting to run the app
        run: |
          sleep 10
         
      - name: checking the app running
        run: |
          curl http://localhost:5000
      
      - name: Push Version Image to Docker Hub
        run: |
          docker push ${{ secrets.DOCKER_USERNAME }}/flask-demo-app:${{ github.sha }}     

      - name: Push Latest Image to Docker Hub
        run: |
          docker push ${{ secrets.DOCKER_USERNAME }}/flask-demo-app:latest

      - name: Checking container logs
        run: |
          docker logs flask-demo-app    

  